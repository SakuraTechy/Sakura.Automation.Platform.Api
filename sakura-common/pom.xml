<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sakura</groupId>
        <artifactId>sakura</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>sakura-common</artifactId>
    <description>公共模块（存放公共工具类，公共配置等）</description>

    <dependencies>
        <!-- CosId（通用、灵活、高性能的分布式 ID 生成器） -->
        <dependency>
            <groupId>me.ahoo.cosid</groupId>
            <artifactId>cosid-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>me.ahoo.cosid</groupId>
            <artifactId>cosid-spring-redis</artifactId>
        </dependency>

        <!-- SMS4J（短信聚合框架，轻松集成多家短信服务，解决接入多个短信 SDK 的繁琐流程） -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-spring-boot-starter</artifactId>
        </dependency>

        <!-- X File Storage（一行代码将文件存储到本地、FTP、SFTP、WebDAV、阿里云 OSS、华为云 OBS...等其它兼容 S3 协议的存储平台） -->
        <dependency>
            <groupId>org.dromara.x-file-storage</groupId>
            <artifactId>x-file-storage-spring</artifactId>
        </dependency>
        <!-- Amazon S3（Amazon Simple Storage Service，亚马逊简单存储服务，通用存储协议 S3，兼容主流云厂商对象存储） -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-java-sdk-s3</artifactId>
        </dependency>

        <!-- FreeMarker（模板引擎） -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>

        <!-- MySQL Java 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- SakurA Starter API 文档模块 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-api-doc</artifactId>
<!--            <version>${revision}</version>-->
        </dependency>

        <!-- SakurA Starter 扩展模块 - CURD（增删改查） -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-extension-crud-mp</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 认证模块 - JustAuth -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-auth-justauth</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 数据权限模块 - MyBatis Plus -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-extension-datapermission-mp</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 数据访问模块 - MyBatis Plus -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-data-mp</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 缓存模块 - JetCache -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-cache-jetcache</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 消息模块 - WebSocket -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-messaging-websocket</artifactId>
            <version>${revision}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SakurA Starter 消息模块 - 邮件 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-messaging-mail</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 验证码模块 - 图形验证码 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-captcha-graphic</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 验证码模块 - 行为验证码 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-captcha-behavior</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 文件处理模块 - Excel -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-file-excel</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 安全模块 - 限流器 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-security-limiter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 安全模块 - 加密 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-security-crypto</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 安全模块 - 脱敏 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-security-mask</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter 安全模块 - 密码编码器 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-security-password</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SakurA Starter JSON 模块 - Jackson -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-json-jackson</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>16</source>
                    <target>16</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>