<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sakura</groupId>
        <artifactId>sakura-starter-extension-crud</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>sakura-starter-extension-crud-core</artifactId>
    <description>SakurA Starter 扩展模块 - CRUD（增删改查） - 核心模块</description>

    <dependencies>
        <!-- Crane4j（一个基于注解的，用于完成一切 “根据 A 的 key 值拿到 B，再把 B 的属性映射到 A” 这类需求的字段填充框架） -->
        <dependency>
            <groupId>cn.crane4j</groupId>
            <artifactId>crane4j-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- Web 模块 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-web</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 认证模块 - SaToken -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-auth-satoken</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
            </exclusions>
            <version>${revision}</version>
        </dependency>

        <!-- 数据访问模块 - 核心模块 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-data-core</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 文件处理模块 - Excel -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-file-excel</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- API 文档模块 -->
        <dependency>
            <groupId>com.sakura</groupId>
            <artifactId>sakura-starter-api-doc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>